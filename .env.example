SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True

# ALLOWED_HOSTS=yourdomain.com,anotherdomain.com (Each host is separated by a comma)
ALLOWED_HOSTS=*

DB_HOST=localhost
DB_PORT=5432
DB_NAME=photolabdb
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Render uses this URL in production; it takes precedence over DB_* values.
DATABASE_URL=
FRONTEND_URL=https://yourapp.onrender.com
EMAIL_VERIFICATION_URL=https://yourapp.onrender.com/api/auth/verify/

# Required when DEBUG=False.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
